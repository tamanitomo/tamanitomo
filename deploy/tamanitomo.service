[Unit]
Description=Tamanitomo web backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/tamanitomo
ExecStart=%h/projects/tamanitomo/.venv/bin/python -m kit.app.hosted
Environment=HERMES_HOME=%h/.hermes
Environment=TAMANITOMO_BIND=127.0.0.1
Environment=TAMANITOMO_PORT=8770
Environment=COMPANION_BIND=127.0.0.1
Environment=COMPANION_PORT=8770
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
